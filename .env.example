# Copy to .env (git-ignored) and fill in, or set these in your IDE run configuration.
# Spring Boot reads real environment variables, so with a .env file run:  set -a; source .env; set +a

DB_URL=jdbc:postgresql://localhost:5432/clinic_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

# First doctor account, created at startup only if no admin exists. Password: 12+ characters.
ADMIN_EMAIL=doctor@example.com
ADMIN_PASSWORD=change-me-please-12+
ADMIN_NAME=Doctor

# Optional
# CLINIC_TIMEZONE=Asia/Kolkata
# BOOKING_HORIZON_DAYS=60
# SWAGGER_ENABLED=false
# CANCELLATION_CUTOFF_HOURS=2   # patients cannot cancel/reschedule closer than this; 0 = no cutoff
